{
  "name": "travelcheck-backend",
  "version": "1.0.0",
  "description": "TravelCheck - 区块链旅行打卡DApp后端",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "keywords": ["blockchain", "travel", "dapp", "backend"],
  "author": "TravelCheck Team",
  "license": "MIT",
  "dependencies": {
    "koa": "^2.15.0",
    "koa-router": "^12.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-cors": "^0.0.16",
    "koa-helmet": "^7.0.2",
    "koa-logger": "^3.2.1",
    "koa-static": "^5.0.0",
    "koa-multer": "^1.0.2",
    "jsonwebtoken": "^9.0.2",
    "ethers": "^6.9.0",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.4.1",
    "@types/koa": "^2.14.0",
    "@types/koa-router": "^7.4.8",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-cors": "^0.0.5",
    "@types/koa-helmet": "^6.0.0",
    "@types/koa-logger": "^3.1.5",
    "@types/koa-multer": "^1.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2"
  }
}
